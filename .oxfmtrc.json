{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "trailingComma": "es5",
  "tabWidth": 2,
  "printWidth": 100,
  "endOfLine": "lf",
  "sortImports": true,
  "sortPackageJson": true,
  "ignorePatterns": [
    "**/node_modules/**",
    "pnpm-lock.yaml",
    "**/dist/**",
    "**/coverage/**",
    ".husky/_/**"
  ]
}
