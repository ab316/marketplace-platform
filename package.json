{
  "name": "marketplace-platform",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @acme/backend dev",
    "build": "pnpm -r run build",
    "start": "pnpm --filter @acme/backend start",
    "typecheck": "pnpm -r run typecheck && tsc -p scripts/tsconfig.json",
    "check:boundaries": "node scripts/check-boundaries.ts",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives . && pnpm run check:boundaries",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "pnpm --filter @acme/backend test",
    "test:unit": "pnpm --filter @acme/backend test:unit",
    "test:memory": "pnpm --filter @acme/backend test:memory",
    "test:coverage": "pnpm --filter @acme/backend test:coverage",
    "migrate:create": "pnpm --filter @acme/backend migrate:create",
    "migrate:up": "pnpm --filter @acme/backend migrate:up",
    "migrate:down": "pnpm --filter @acme/backend migrate:down",
    "check": "pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{json,jsonc,md,mdx,yml,yaml,css,scss,less,html,vue,graphql,gql}": [
      "oxfmt --write"
    ]
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.11.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@12.11.2"
}
