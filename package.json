{
  "name": "marketplace-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @acme/backend dev",
    "build": "pnpm --filter @acme/backend build",
    "start": "pnpm --filter @acme/backend start",
    "typecheck": "pnpm -r typecheck",
    "check:boundaries": "pnpm --filter @acme/backend exec node --import tsx ../../scripts/check-boundaries.ts",
    "lint": "oxlint . && pnpm run check:boundaries",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "pnpm --filter @acme/backend test",
    "test:coverage": "pnpm --filter @acme/backend test:coverage",
    "migrate:create": "pnpm --filter @acme/backend migrate:create",
    "migrate:up": "pnpm --filter @acme/backend migrate:up",
    "migrate:down": "pnpm --filter @acme/backend migrate:down",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{json,jsonc,md,mdx,yml,yaml,css,scss,less,html,vue,graphql,gql}": [
      "oxfmt --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^5.9.3"
  }
}
