{
  "name": "@acme/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.ts --watch --run",
    "build": "node esbuild.config.ts",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "migrate:create": "node-pg-migrate create --migrations-dir migrations --database-url-var DATABASE_URL",
    "migrate:up": "node-pg-migrate up --migrations-dir migrations --database-url-var DATABASE_URL",
    "migrate:down": "node-pg-migrate down --migrations-dir migrations --database-url-var DATABASE_URL"
  },
  "dependencies": {
    "@acme/api-contracts": "workspace:*",
    "@acme/core-contracts": "workspace:*",
    "@asteasolutions/zod-to-openapi": "^8.4.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "@opentelemetry/auto-instrumentations-node": "^0.69.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.212.0",
    "@opentelemetry/sdk-node": "^0.212.0",
    "bullmq": "^5.69.1",
    "dayjs": "^1.11.19",
    "dotenv": "^17.3.1",
    "fastify": "^5.7.4",
    "ioredis": "^5.9.3",
    "kysely": "^0.28.11",
    "nanoid": "^5.1.6",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "0.28.2",
    "node-pg-migrate": "^9.0.0",
    "testcontainers": "^12.2.0",
    "vitest": "^5.0.3"
  }
}
