NODE_ENV=development
LOG_LEVEL=info
HOST=127.0.0.1
PORT=3000

# memory | postgres
# "memory" keeps everything in process so the API runs with no dependencies. Use it for local
# exploration only; "postgres" uses the migrated schema and requires DATABASE_URL.
PERSISTENCE=memory

DATABASE_URL=postgres://postgres:postgres@localhost:5432/marketplace

# UC-001: an unpaid order holds its reserved unit for 24 hours.
ORDER_RESERVATION_TTL_HOURS=24
# How often overdue unpaid orders are released. 0 disables the sweep.
ORDER_EXPIRY_SWEEP_INTERVAL_MS=60000
ORDER_EXPIRY_SWEEP_BATCH_SIZE=100

# Not used yet; reserved for later phases.
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
