NODE_ENV=development
LOG_LEVEL=info
HOST=127.0.0.1
# `pnpm dev` overrides this from BACKEND_PORT in the repo-root .env so both apps agree.
PORT=4000

# memory | postgres
# "memory" keeps everything in process so the API runs with no dependencies. Use it for local
# exploration only; "postgres" uses the migrated schema and requires DATABASE_URL.
PERSISTENCE=memory

DATABASE_URL=postgres://postgres:postgres@localhost:5432/marketplace

# UC-001: an unpaid order holds its reserved unit for 24 hours.
ORDER_RESERVATION_TTL_HOURS=24
# How often overdue unpaid orders are released. 0 disables the sweep.
ORDER_EXPIRY_SWEEP_INTERVAL_MS=60000
ORDER_EXPIRY_SWEEP_BATCH_SIZE=100

# How long a session stays usable before the user signs in again (ADR-008). Sessions are opaque
# tokens stored server-side, so shortening this does not weaken revocation: signing out or
# changing a password invalidates sessions immediately either way.
SESSION_TTL_HOURS=168

# Payments (UC-004, PD-0004). Phase 4 runs on the built-in simulated provider only.
PAYMENT_PROVIDER=simulated
# Shared secret for HMAC-signed provider callbacks (min 16 chars). The default is for local use only.
PAYMENT_PROVIDER_WEBHOOK_SECRET=local-dev-webhook-secret
# How long a payment in progress protects the order from expiry; an unanswered attempt times out here.
PAYMENT_ATTEMPT_TIMEOUT_MINUTES=15
# How often overdue payment attempts are closed. 0 disables the sweep.
PAYMENT_TIMEOUT_SWEEP_INTERVAL_MS=60000
PAYMENT_TIMEOUT_SWEEP_BATCH_SIZE=100
# Marketplace fee, seller-borne, in basis points (800 = 8%). Frozen per order at payment time.
PLATFORM_FEE_BPS=800

# Not used yet; reserved for later phases.
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
