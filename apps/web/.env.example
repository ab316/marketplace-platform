# Copy to .env.local for local development. Never commit .env.local.
#
# Server-side only. Nothing here may be prefixed NEXT_PUBLIC_: the backend URL is internal, and
# identity-provider secrets (ADR-012) must never reach the browser bundle.

# Base URL of the Fastify backend, as reachable from the Next.js server. No trailing slash.
BACKEND_API_URL=http://localhost:3000
