{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "node", "promise", "vitest"],
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/node_modules/**",
    "**/.turbo/**",
    "**/.next/**",
    "**/.cache/**",
    ".husky/**"
  ],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "eqeqeq": "error",
    "radix": "error",
    "no-console": "error",
    "no-param-reassign": "error",
    "import/no-cycle": "error",
    "node/no-process-env": "error",
    "unicorn/require-module-specifiers": "off"
  },
  "overrides": [
    {
      "files": ["**/*.{ts,tsx,mts,cts}"],
      "rules": {
        "typescript/no-explicit-any": "error",
        "typescript/no-unsafe-assignment": "error",
        "typescript/no-unsafe-argument": "error",
        "typescript/no-unsafe-call": "error",
        "typescript/no-unsafe-member-access": "error",
        "typescript/no-unsafe-return": "error",
        "typescript/consistent-type-imports": ["error", { "prefer": "type-imports" }],
        "typescript/no-floating-promises": "error",
        "typescript/no-misused-promises": "error",
        "typescript/await-thenable": "error",
        "typescript/require-await": "error",
        "typescript/switch-exhaustiveness-check": [
          "error",
          { "considerDefaultExhaustiveForUnions": false }
        ],
        "typescript/strict-boolean-expressions": ["error", { "allowNumber": false }],
        "typescript/prefer-nullish-coalescing": "error",
        "typescript/no-unnecessary-condition": "error",
        "typescript/return-await": ["error", "in-try-catch"],
        "typescript/only-throw-error": "error",
        "typescript/prefer-promise-reject-errors": "error",
        "typescript/no-unnecessary-type-assertion": "error",
        "typescript/no-non-null-assertion": "error",
        "typescript/no-deprecated": "error",
        "typescript/ban-ts-comment": ["error", { "minimumDescriptionLength": 10 }]
      }
    },
    {
      "files": ["**/test/**", "**/*.{test,spec}.ts"],
      "rules": {
        "vitest/no-focused-tests": "error",
        "vitest/no-disabled-tests": "warn"
      }
    },
    {
      "files": ["scripts/**", "**/*.config.ts"],
      "rules": {
        "no-console": "off",
        "node/no-process-env": "off"
      }
    },
    {
      // Side-effect imports are load-bearing in Next.js: `server-only` is a build-time guard,
      // global CSS has no binding, and `next-env.d.ts` is generated. None of them assign.
      "files": ["apps/web/**/*.{ts,tsx}", "apps/web/next-env.d.ts"],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    },
    {
      // The single place the web app reads raw configuration; everything else imports the
      // validated `serverEnv()` from here.
      "files": ["apps/web/src/lib/env.ts"],
      "rules": {
        "node/no-process-env": "off"
      }
    }
  ]
}
