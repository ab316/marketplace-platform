# Copy to `.env` at the repo root. Read by `pnpm dev` (scripts/dev.ts) and by `docker compose` to
# decide which ports the local stack listens on. Per-app settings stay in apps/*/.env(.local) —
# only cross-app wiring belongs here.
#
# These are the main checkout's defaults. In a git worktree, run `pnpm env:init` instead of copying
# this file. `pnpm dev` forwards BACKEND_PORT to the web app as BACKEND_API_URL.
#
# Port 3000 is deliberately avoided: it collides with almost every other Node tool.

# Names the Postgres container and its volume (docker compose).
COMPOSE_PROJECT_NAME=marketplace
# Host port Postgres is published on; must match DATABASE_URL in apps/backend/.env.
POSTGRES_PORT=5432
BACKEND_PORT=4000
WEB_PORT=4001
