# Copy to `.env` at the repo root. Read by `pnpm dev` (scripts/dev.ts) to decide which ports the
# local stack listens on. Per-app settings stay in apps/*/.env.local — only cross-app wiring
# belongs here.
#
# Port 3000 is deliberately avoided: it collides with almost every other Node tool.

BACKEND_PORT=4000
WEB_PORT=4001
